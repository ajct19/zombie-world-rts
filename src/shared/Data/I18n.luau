function I18n.get(): string
	return _lang
end

function I18n.set(lang: string): boolean
	local target = norm_lang(lang)
	if target == _lang then
		return false
	end
	_lang = target
	I18n.changed:Fire(_lang)
	return true
end

function I18n.toggle(): string
	I18n.set(if _lang == "ru" then "en" else "ru")
	return _lang
end


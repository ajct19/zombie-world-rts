function I18n.struct_title(kind: number, is_zombie_survivor: boolean?): string
	if kind == 3 and is_zombie_survivor then
		return I18n.t("bunker_title")
	end
	local k = STRUCT_KEYS[kind]
	return if k ~= nil then I18n.t(k) else ""
end

function I18n.nuke_title(kind: number): string
	local k = NUKE_KEYS[kind]
	return if k ~= nil then I18n.t(k) else ""
end

function I18n.map_name(id: string?, fallback: string?): string
	if _lang == "ru" and type(id) == "string" then
		local mapped = RU_MAP_NAMES[string.lower(id)]
		if mapped ~= nil then
			return mapped
		end
	end
	return fallback or id or ""
end

function I18n.t(key: string, ...: any): string
	local tbl = STRINGS[_lang] or STRINGS.en
	local tpl = tbl[key] or STRINGS.en[key] or key
	if select("#", ...) > 0 then
		local ok, out = pcall(string.format, tpl, ...)
		if ok and type(out) == "string" then
			return out
		end
	end
	return tpl
end

return I18n

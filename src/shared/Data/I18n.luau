function I18n.owner_name(name: string?): string
	local s = if type(name) == "string" then name else ""
	if _lang == "ru" then
		local mapped = RU_OWNER_NAMES[s]
		if mapped ~= nil then
			return mapped
		end
	end
	return s
end

